<h3>予定の新規追加</h3>

<%= form_with model: @schedule, local: true do |f| %>
  <table>
    <tr>
      <th><%= f.label :title, "タイトル" %></th>
      <td><%= f.text_field :title %></td>
    </tr>

    <tr>
      <th><%= f.label :start, "開始日" %></th>
      <td><%= f.date_field :start %></td>
    </tr>

    <tr>
      <th><%= f.label :end_date, "終了日" %></th>
      <td><%= f.date_field :end_date %></td>
    </tr>

    <tr>
      <th><%= f.label :allday, "終日" %></th>
      <td><%= f.check_box :allday, {}, "1", "" %></td>
    </tr>

    <tr>
      <th><%= f.label :schedule_memo, "スケジュールメモ" %></th>
      <td><%= f.text_area :schedule_memo %></td>
    </tr>
  </table>

  <% if @schedule.errors.any? %>
    <div class="alert alert-danger">
      <ul>
        <% @schedule.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>


  <div>
    <ul>
     <li><%= f.submit "登録完了" %></li>
     <li><%= link_to "予定一覧に戻る", :schedules %></li>
    </ul>
  </div>
<% end %>