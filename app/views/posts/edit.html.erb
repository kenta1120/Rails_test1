<h3>予定編集</h3>

<%= form_with model: @post do |f| %>
  <table>
    <tr>
      <th><%= f.label :content, "予定の内容"%></th>
      <td><%= f.text_area :content, class:"posts-content"%></td>
    </tr>

    <div>
      <ul>
        <li><%= f.submit "編集を完了する"%></li>
        <li><%= link_to "予定一覧へ戻る", :shedules %></li>
      </ul>
    </div>
  </table>